// Full Stack AI Development Agent
// Multi-platform code organization and deployment system

const fs = require('fs').promises;
const path = require('path');
const { exec } = require('child_process');
const util = require('util');
const execAsync = util.promisify(exec);

class AIDevAgent {
  constructor() {
    this.platforms = {
      react: { extensions: ['.jsx', '.tsx'], buildCmd: 'npm run build' },
      python: { extensions: ['.py'], buildCmd: 'python -m pip install -r requirements.txt' },
      nextjs: { extensions: ['.js', '.jsx', '.ts', '.tsx'], buildCmd: 'npm run build' },
      nodejs: { extensions: ['.js', '.ts'], buildCmd: 'npm install' },
      solana: { extensions: ['.rs'], buildCmd: 'anchor build' },
      solidity: { extensions: ['.sol'], buildCmd: 'hardhat compile' },
      html: { extensions: ['.html', '.css', '.js'], buildCmd: 'echo "Static files ready"' },
      ssh: { extensions: ['.sh', '.config'], buildCmd: 'chmod +x *.sh' },
      markdown: { extensions: ['.md'], buildCmd: 'echo "Documentation ready"' }
    };
    
    this.projectStructure = {
      organized: false,
      projects: [],
      deploymentStatus: {},
      lastSync: null
    };
  }

  // Initialize the agent and scan for projects
  async initialize() {
    console.log('🤖 AI Development Agent Initializing...');
    await this.scanProjects();
    await this.createProjectStructure();
    console.log('✅ Agent initialized successfully!');
  }

  // Scan all directories for development projects
  async scanProjects() {
    const commonPaths = [
      process.cwd(),
      path.join(process.env.HOME || process.env.USERPROFILE, 'Desktop'),
      path.join(process.env.HOME || process.env.USERPROFILE, 'Documents'),
      path.join(process.env.HOME || process.env.USERPROFILE, 'Projects'),
      '/storage/emulated/0', // Android path for Samsung tablet
      '/sdcard' // Alternative Android path
    ];

    for (const basePath of commonPaths) {
      try {
        await this.scanDirectory(basePath);
      } catch (error) {
        console.log(`⚠️  Skipping ${basePath}: ${error.message}`);
      }
    }
  }

  async scanDirectory(dirPath, depth = 0) {
    if (depth > 3) return; // Limit scanning depth

    try {
      const items = await fs.readdir(dirPath);
      
      for (const item of items) {
        const fullPath = path.join(dirPath, item);
        const stat = await fs.stat(fullPath);
        
        if (stat.isDirectory() && !item.startsWith('.') && item !== 'node_modules') {
          const projectType = await this.detectProjectType(fullPath);
          if (projectType) {
            this.projectStructure.projects.push({
              name: item,
              path: fullPath,
              type: projectType,
              lastModified: stat.mtime,
              status: 'discovered'
            });
          }
          await this.scanDirectory(fullPath, depth + 1);
        }
      }
    } catch (error) {
      // Silently skip inaccessible directories
    }
  }

  async detectProjectType(projectPath) {
    const files = await fs.readdir(projectPath).catch(() => []);
    
    // Check for specific project indicators
    if (files.includes('package.json')) {
      const packageJson = await this.readJSON(path.join(projectPath, 'package.json'));
      if (packageJson?.scripts?.dev && packageJson?.dependencies?.next) return 'nextjs';
      if (packageJson?.dependencies?.react) return 'react';
      return 'nodejs';
    }
    
    if (files.includes('requirements.txt') || files.includes('setup.py')) return 'python';
    if (files.includes('Anchor.toml')) return 'solana';
    if (files.includes('hardhat.config.js') || files.some(f => f.endsWith('.sol'))) return 'solidity';
    if (files.includes('index.html')) return 'html';
    if (files.some(f => f.endsWith('.md'))) return 'markdown';
    if (files.some(f => f.endsWith('.sh'))) return 'ssh';
    
    return null;
  }

  async readJSON(filePath) {
    try {
      const content = await fs.readFile(filePath, 'utf8');
      return JSON.parse(content);
    } catch {
      return null;
    }
  }

  // Create organized project structure
  async createProjectStructure() {
    const organizationPath = path.join(process.cwd(), 'organized-projects');
    
    try {
      await fs.mkdir(organizationPath, { recursive: true });
      
      // Group projects by type
      const projectsByType = {};
      this.projectStructure.projects.forEach(project => {
        if (!projectsByType[project.type]) {
          projectsByType[project.type] = [];
        }
        projectsByType[project.type].push(project);
      });

      // Create type-based directories and symlinks
      for (const [type, projects] of Object.entries(projectsByType)) {
        const typePath = path.join(organizationPath, type);
        await fs.mkdir(typePath, { recursive: true });
        
        for (const project of projects) {
          const linkPath = path.join(typePath, project.name);
          try {
            await fs.symlink(project.path, linkPath);
            project.status = 'organized';
          } catch (error) {
            console.log(`⚠️  Could not create symlink for ${project.name}: ${error.message}`);
          }
        }
      }

      await this.generateDashboard(organizationPath);
      this.projectStructure.organized = true;
      
    } catch (error) {
      console.error('❌ Error creating project structure:', error.message);
    }
  }

  // Generate a dashboard HTML file
  async generateDashboard(organizationPath) {
    const dashboardHTML = `
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Dev Agent Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #1a1a1a; color: #fff; }
        .header { text-align: center; margin-bottom: 30px; }
