        .stats { display: flex; justify-content: space-around; margin-bottom: 30px; }
        .stat { text-align: center; }
        .stat-number { font-size: 2em; font-weight: bold; color: #4CAF50; }
    </style>
</head>
<body>
    <div class="header">
        <h1>🤖 AI Development Agent Dashboard</h1>
        <p>Managing your multi-platform development projects</p>
    </div>
    
    <div class="stats">
        <div class="stat">
            <div class="stat-number">${this.projectStructure.projects.length}</div>
            <div>Total Projects</div>
        </div>
        <div class="stat">
            <div class="stat-number">${Object.keys(this.platforms).length}</div>
            <div>Supported Platforms</div>
        </div>
        <div class="stat">
            <div class="stat-number">${this.projectStructure.projects.filter(p => p.status === 'organized').length}</div>
            <div>Organized Projects</div>
        </div>
    </div>
    
    <div class="project-grid">
        ${this.projectStructure.projects.map(project => `
            <div class="project-card">
                <div class="project-type">${project.type.toUpperCase()}</div>
