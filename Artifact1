                <p><strong>Path:</strong> ${project.path}</p>
                <p><strong>Last Modified:</strong> ${project.lastModified.toLocaleDateString()}</p>
                <div class="actions">
                    <button class="btn" onclick="openProject('${project.path}')">Open</button>
                    <button class="btn" onclick="buildProject('${project.name}', '${project.type}')">Build</button>
                    <button class="btn" onclick="deployProject('${project.name}')">Deploy</button>
                </div>
            </div>
        `).join('')}
    </div>
    
    <script>
        function openProject(path) {
            // This would integrate with your device's file manager
            alert('Opening project at: ' + path);
        }
        
        function buildProject(name, type) {
            alert('Building ' + type + ' project: ' + name);
            // This would trigger the build command
        }
        
        function deployProject(name) {
            alert('Deploying project: ' + name);
            // This would trigger deployment
        }
        
        // Auto-refresh every 30 seconds
        setTimeout(() => location.reload(), 30000);
    </script>
</body>
</html>`;

    await fs.writeFile(path.join(organizationPath, 'dashboard.html'), dashboardHTML);
    console.log('📊 Dashboard created at: ' + path.join(organizationPath, 'dashboard.html'));
  }

  // Build a specific project
  async buildProject(projectName) {
    const project = this.projectStructure.projects.find(p => p.name === projectName);
    if (!project) {
      console.error(`❌ Project ${projectName} not found`);
      return;
    }

    console.log(`🔨 Building ${project.type} project: ${project.name}`);
    
    try {
      const buildCmd = this.platforms[project.type].buildCmd;
      const { stdout, stderr } = await execAsync(buildCmd, { cwd: project.path });
      
      console.log(`✅ Build successful for ${project.name}`);
      if (stdout) console.log('Output:', stdout);
      
      project.status = 'built';
      this.projectStructure.deploymentStatus[project.name] = 'built';
      
    } catch (error) {
      console.error(`❌ Build failed for ${project.name}:`, error.message);
      project.status = 'build-failed';
    }
  }

  // Deploy a project (basic implementation)
  async deployProject(projectName) {
    const project = this.projectStructure.projects.find(p => p.name === projectName);
    if (!project) {
      console.error(`❌ Project ${projectName} not found`);
      return;
    }

    console.log(`🚀 Deploying ${project.type} project: ${project.name}`);
    
    // This is a basic implementation - you'd customize based on your deployment targets
    try {
      switch (project.type) {
        case 'nextjs':
        case 'react':
          console.log('📦 Deploying to Vercel/Netlify...');
          // Add your deployment logic here
          break;
        case 'nodejs':
          console.log('🔧 Deploying to server...');
          // Add your server deployment logic here
          break;
        case 'solana':
          console.log('⚡ Deploying to Solana network...');
          // Add Solana deployment logic here
          break;
        case 'solidity':
          console.log('💎 Deploying smart contracts...');
          // Add Ethereum deployment logic here
          break;
        default:
          console.log('📁 Preparing static files...');
      }
      
      project.status = 'deployed';
      this.projectStructure.deploymentStatus[project.name] = 'deployed';
      console.log(`✅ Deployment successful for ${project.name}`);
      
    } catch (error) {
      console.error(`❌ Deployment failed for ${project.name}:`, error.message);
      project.status = 'deploy-failed';
    }
  }

  // Sync projects across devices
  async syncProjects() {
    console.log('🔄 Syncing projects across devices...');
    
    // Create a sync manifest
    const syncManifest = {
      timestamp: new Date().toISOString(),
      projects: this.projectStructure.projects.map(p => ({
        name: p.name,
        type: p.type,
        status: p.status,
        lastModified: p.lastModified,
        checksum: await this.calculateChecksum(p.path)
      }))
    };

    await fs.writeFile(
      path.join(process.cwd(), 'sync-manifest.json'), 
      JSON.stringify(syncManifest, null, 2)
    );

    this.projectStructure.lastSync = new Date();
    console.log('✅ Sync manifest created');
  }

  async calculateChecksum(projectPath) {
    // Simple checksum calculation based on file count and total size
    try {
      const files = await this.getAllFiles(projectPath);
      return files.length.toString() + '-' + Date.now().toString().slice(-6);
    } catch {
      return 'unknown';
    }
  }

  async getAllFiles(dir) {
    const files = [];
    const items = await fs.readdir(dir).catch(() => []);
    
    for (const item of items) {
      const fullPath = path.join(dir, item);
      const stat = await fs.stat(fullPath).catch(() => null);
      
      if (stat?.isDirectory() && !item.startsWith('.') && item !== 'node_modules') {
        files.push(...await this.getAllFiles(fullPath));
      } else if (stat?.isFile()) {
        files.push(fullPath);
      }
    }
    
    return files;
  }

  // Generate deployment scripts
  async generateDeploymentScripts() {
    const scriptsPath = path.join(process.cwd(), 'deployment-scripts');
    await fs.mkdir(scriptsPath, { recursive: true });

    // Docker deployment script
    const dockerScript = `#!/bin/bash
# Auto-generated deployment script by AI Dev Agent

echo "🐳 Starting Docker deployment..."

# Build and deploy each project type
${this.projectStructure.projects.map(project => `
# Deploy ${project.name} (${project.type})
cd "${project.path}"
if [ -f "Dockerfile" ]; then
    docker build -t ${project.name.toLowerCase()} .
    docker run -d -p 3000:3000 --name ${project.name.toLowerCase()} ${project.name.toLowerCase()}
fi
`).join('\n')}

echo "✅ Deployment complete!"
`;

    await fs.writeFile(path.join(scriptsPath, 'deploy-docker.sh'), dockerScript);
    await execAsync(`chmod +x ${path.join(scriptsPath, 'deploy-docker.sh')}`).catch(() => {});

    // Git sync script
    const gitScript = `#!/bin/bash
# Auto-generated git sync script by AI Dev Agent

echo "📁 Syncing all projects to Git..."

${this.projectStructure.projects.map(project => `
# Sync ${project.name}
cd "${project.path}"
if [ -d ".git" ]; then
    git add .
    git commit -m "Auto-sync by AI Dev Agent $(date)"
    git push origin main || git push origin master
fi
`).join('\n')}

echo "✅ Git sync complete!"
`;

    await fs.writeFile(path.join(scriptsPath, 'git-sync.sh'), gitScript);
    await execAsync(`chmod +x ${path.join(scriptsPath, 'git-sync.sh')}`).catch(() => {});

    console.log('📜 Deployment scripts generated in:', scriptsPath);
  }

  // Main execution method
  async run() {
    try {
      await this.initialize();
      await this.syncProjects();
      await this.generateDeploymentScripts();
      
      console.log('\n🎉 AI Development Agent Setup Complete!');
      console.log(`📊 Found ${this.projectStructure.projects.length} projects`);
      console.log('📁 Check the organized-projects folder for your structured codebase');
      console.log('🌐 Open dashboard.html in your browser to manage projects');
      console.log('\n📋 Available Commands:');
      console.log('  - agent.buildProject("project-name")');
      console.log('  - agent.deployProject("project-name")');
      console.log('  - agent.syncProjects()');
      
      return this.projectStructure;
      
    } catch (error) {
      console.error('❌ Agent execution failed:', error.message);
      throw error;
    }
  }

  // Status report
  getStatus() {
    return {
      organized: this.projectStructure.organized,
      totalProjects: this.projectStructure.projects.length,
      projectsByType: this.projectStructure.projects.reduce((acc, p) => {
        acc[p.type] = (acc[p.type] || 0) + 1;
        return acc;
      }, {}),
      lastSync: this.projectStructure.lastSync,
      deploymentStatus: this.projectStructure.deploymentStatus
    };
  }
}

// Usage example and initialization
const agent = new AIDevAgent();

// Export for use
if (typeof module !== 'undefined' && module.exports) {
  module.exports = AIDevAgent;
}

// Auto-run if executed directly
if (require.main === module) {
  agent.run().then(() => {
    console.log('\n🤖 AI Dev Agent is now monitoring your projects!');
    console.log('Current status:', JSON.stringify(agent.getStatus(), null, 2));
  }).catch(console.error);
}

// For browser/React Native usage
if (typeof window !== 'undefined') {
  window.AIDevAgent = AIDevAgent;
}
